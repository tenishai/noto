+def _parse_headers(spec: str) -> dict[str, str]:
+    """'Name=Value, Other=Value' -> dict. Values may contain '='; names may not."""
+    headers = {}
+    for pair in spec.split(","):
+        name, sep, value = pair.partition("=")
+        if sep and name.strip():
+            headers[name.strip()] = value.strip()
+    return headers
+
+
 def get_handler() -> Handler:
     """liminal entry-point factory (inert until liminal is installed)."""
     return MetricsHandler()
diff --git a/tests/test_handlers.py b/tests/test_handlers.py
index c907293..dfdaec0 100644
--- a/tests/test_handlers.py
+++ b/tests/test_handlers.py
@@ -73,6 +73,42 @@ async def test_google_auth_attaches_metadata_token():
     assert seen["auth"] == "Bearer tok-123"
 
 
+async def test_custom_headers_attach_to_prometheus_requests():
+    seen = {}
+
+    def router(request):
+        seen["org"] = request.headers.get("X-Scope-OrgID")
+        seen["extra"] = request.headers.get("X-Extra")
+        return httpx.Response(200, json={"status": "success", "data": {"result": []}})
+
+    h = MetricsHandler(http=client(router))
+    res = await h.dispatch("metrics.query_instant", {"query": "up"},
+                           ctx(prometheus_url="http://mimir",
+                               prometheus_headers="X-Scope-OrgID=argus-smoke, X-Extra=v=1"))
+    assert not res.is_error
+    assert seen["org"] == "argus-smoke"
+    assert seen["extra"] == "v=1"   # values may contain '='
+
+
+async def test_auth_mode_wins_the_authorization_header():
+    seen = {}
+
+    def router(request):
+        if "metadata.google.internal" in str(request.url):
+            return httpx.Response(200, json={"access_token": "tok-123"})
+        seen["auth"] = request.headers.get("Authorization")
+        seen["org"] = request.headers.get("X-Scope-OrgID")
+        return httpx.Response(200, json={"status": "success", "data": {"result": []}})
+
+    h = MetricsHandler(http=client(router))
+    res = await h.dispatch("metrics.query_instant", {"query": "up"},
+                           ctx(prometheus_url="http://mimir", prometheus_auth="google",
+                               prometheus_headers="X-Scope-OrgID=t1, Authorization=Basic nope"))
+    assert not res.is_error
+    assert seen["org"] == "t1"
+    assert seen["auth"] == "Bearer tok-123"
+
